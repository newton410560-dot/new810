{
  "name": "el-sewedy-qc-system",
  "version": "1.0.0",
  "description": "El Sewedy Chemical Industries - QC & Bolomey Mix Design ERP (Windows + Android + iOS)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.elsewedy.qcerp",
    "productName": "El Sewedy QC System",
    "files": [
      "main.js",
      "icon.png",
      "www/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}